# .gitignore

# Environment
.becavenv

#Audio Files
*.mp3 
*.MP3
*.wav
*.flac

# Images
*.jpg
*.jpeg
*.png

# Models and training logs (too heavy; their _Labels/_Params/metrics files are kept)
*.tflite
*.log

# Microphone locations are sensitive (snipe breeding sites): never in git.
# Only the public département outlines are kept. The viz page embeds positions.
code/data/geo/*
!code/data/geo/departements.geojson
code/results/survey/viz/

# Slurm job logs (cluster)
code/logs/

# Python cache
__pycache__/
*.pyc

# Stray copy of a recorder card
code/data/2026_Beca_SMMICRO_070_25_Bouverans/

# Claude files
CLAUDE.md
.claude/
.~lock.*
